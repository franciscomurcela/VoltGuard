# ═══════════════════════════════════════════════════════════════════════════
# VoltGuard — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Compositor ──────────────────────────────────────────────────────────────
COMPOSITOR_KC_SECRET=change-me-in-production
COMPOSITOR_SESSION_SECRET=change-me-random-string-at-least-32-chars

# ─── Peer Service URLs (override if non-default) ────────────────────────────
# OAM_SERVICE_URL=http://oam-service:8080

# ─── Notifications ───────────────────────────────────────────────────────────
NOTIFICATIONS_DB_PASSWORD=notifications_password
NOTIFICATIONS_AUTH_TOKEN=your_secure_auth_token
PREFERENCES_LINK_BASE_URL=http://localhost:3000/preferences

# ─── Anomaly Detection ──────────────────────────────────────────────────────
ANOMALY_APP_TOKEN=token_do_composer_123
RABBITMQ_USER=voltguard
RABBITMQ_PASS=voltguard123

# ─── Twilio (optional) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC6710082726b1a87a08a873f6b8008ee2
TWILIO_AUTH_TOKEN=11214181a8628b7466ac45de6899fe4a
TWILIO_FROM_PHONE=+15014746451
TWILIO_FROM_WHATSAPP=
TWILIO_FROM_EMAIL=alertasvoltguard@gmail.com

# ─── SMTP (Email via Gmail) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=alertasvoltguard@gmail.com
SMTP_PASSWORD=oaelamwyyfphelbb
SMTP_FROM_EMAIL=alertasvoltguard@gmail.com

# ─── Notifications seed (optional) ──────────────────────────────────────────
SEED_DEFAULT_PREFERENCES=true

# ─── General ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
