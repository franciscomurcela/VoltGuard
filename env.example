# ═══════════════════════════════════════════════════════════════════════════
# VoltGuard — Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Compositor ──────────────────────────────────────────────────────────────
COMPOSITOR_KC_SECRET=change-me-in-production
COMPOSITOR_SESSION_SECRET=change-me-random-string-at-least-32-chars
AUTH_DISABLED=true

# ─── OAM ─────────────────────────────────────────────────────────────────────
OAM_DB_PASSWORD=oam_pass
OAM_BASE_URL=http://localhost:8084

# ─── Peer Service URLs (override if services run on non-default ports) ───────
# OAM_SERVICE_URL=http://oam-service:8080
# ANOMALY_SERVICE_URL=http://anomaly-service:8080

# ─── Notifications ───────────────────────────────────────────────────────────
NOTIFICATIONS_DB_PASSWORD=notifications_password
NOTIFICATIONS_AUTH_TOKEN=your_secure_auth_token

# ─── Twilio (optional) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_FROM_WHATSAPP=
TWILIO_FROM_EMAIL=noreply@voltguard.com

# ─── SendGrid (optional) ────────────────────────────────────────────────────
SENDGRID_API_KEY=

# ─── General ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
