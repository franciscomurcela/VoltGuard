apiVersion: v1
kind: Secret
metadata:
  name: voltguard-secrets
  namespace: tenant-grupo4-egs-deti-ua-pt
stringData:
  # Keycloak client secret for compositor-backend (must match realm-export.json)
  COMPOSITOR_KC_SECRET: "CHANGE_ME"
  # Random string for Express session signing (min 32 chars)
  COMPOSITOR_SESSION_SECRET: "CHANGE_ME_MIN_32_CHARS"
  # Shared token between notifications-service and compositor-backend
  NOTIFICATIONS_AUTH_TOKEN: "CHANGE_ME"
  # Token anomaly-api uses to call composer endpoints
  ANOMALY_APP_TOKEN: "CHANGE_ME"
  # Tokens for anomaly-api's own API (used by test scripts)
  VG_APP_TOKEN: "CHANGE_ME"
  VG_ADMIN_TOKEN: "CHANGE_ME"
  # OAM PostgreSQL password (must match postgres-oam POSTGRES_PASSWORD)
  OAM_DB_PASSWORD: "CHANGE_ME"
  # Full OAM database URL (update OAM_DB_PASSWORD value here too)
  DATABASE_URL: "postgres://oam_user:CHANGE_ME@postgres-oam:5432/oam_db"
  # MongoDB password for notifications-db (must match MONGO_INITDB_ROOT_PASSWORD)
  NOTIFICATIONS_DB_PASSWORD: "CHANGE_ME"
  # Full MongoDB URL (update NOTIFICATIONS_DB_PASSWORD value here too)
  MONGODB_URL: "mongodb://admin:CHANGE_ME@notifications-db:27017"
  # Keycloak PostgreSQL password (must match postgres-keycloak POSTGRES_PASSWORD)
  KEYCLOAK_DB_PASSWORD: "CHANGE_ME"
  # Keycloak admin console password
  KEYCLOAK_ADMIN_PASSWORD: "CHANGE_ME"
