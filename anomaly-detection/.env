# Persistência MongoDB
# Overridden in docker-compose.yaml (anomaly-api does not use MongoDB currently)
VG_MONGO_URI=
VG_MONGO_DB=voltguard

# Ingestão periódica
VG_PERIODIC_INGESTION_ENABLED=0
VG_INGESTION_INTERVAL_SECONDS=60
VG_INGESTION_MODE=composer_push

# Modo datasets (default): fontes reais importadas periodicamente
VG_DATASET_1_URL=https://archive.ics.uci.edu/static/public/235/individual+household+electric+power+consumption.zip
VG_DATASET_1_SOURCE_ID=sensor_periodic_uci_household
VG_DATASET_1_METRIC_NAME=global_active_power
VG_DATASET_1_TIMESTAMP_COLUMN=
VG_DATASET_1_TIMESTAMP_FORMAT=%d/%m/%Y %H:%M:%S
VG_DATASET_1_DATE_COLUMN=Date
VG_DATASET_1_TIME_COLUMN=Time
VG_DATASET_1_VALUE_COLUMN=Global_active_power
VG_DATASET_1_DELIMITER=;
VG_DATASET_1_TEMPORAL_MODE=hourly
VG_DATASET_1_AGGREGATION=none
VG_DATASET_1_MAX_ROWS=1000

VG_DATASET_2_URL=https://raw.githubusercontent.com/jenfly/opsd/master/opsd_germany_daily.csv
VG_DATASET_2_SOURCE_ID=sensor_periodic_opsd
VG_DATASET_2_METRIC_NAME=consumption
VG_DATASET_2_TIMESTAMP_COLUMN=Date
VG_DATASET_2_VALUE_COLUMN=Consumption
VG_DATASET_2_DELIMITER=
VG_DATASET_2_TEMPORAL_MODE=daily
VG_DATASET_2_AGGREGATION=mean
VG_DATASET_2_MAX_ROWS=0

# Modo composer (opcional): usa endpoints externos para sensores/medições
VG_COMPOSER_BASE_URL=http://127.0.0.1:8000
VG_COMPOSER_SENSORS_PATH=/v1/sensors
VG_COMPOSER_MEASUREMENTS_PATH_TEMPLATE=/v1/sensors/{sensor_id}/measurements?limit={limit}
VG_COMPOSER_DATASETS_POST_PATH=/v1/anomalies/datasets/push
VG_COMPOSER_TIMEOUT_SECONDS=20
VG_COMPOSER_TOKEN=
VG_COMPOSER_WEBHOOK_URL=http://127.0.0.1:8000/v1/anomalies/webhook
VG_COMPOSER_MEASUREMENTS_LIMIT=500
VG_DEFAULT_METRIC_NAME=voltage

# Tokens locais da API (scripts de teste)
VG_APP_TOKEN=token_do_composer_123
VG_ADMIN_TOKEN=token_admin_999

