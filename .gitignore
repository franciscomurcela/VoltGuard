# Rust build artifacts (multi-service monorepo)
**/target/

# Cargo.lock is kept for applications (binary crates)
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# Environment files (contain secrets — never commit)
.env
.env.local
.env.*.local

# Firmware binary storage (large binary files)
**/firmware_storage/

# Binary files
*.bin

# SQLx offline query cache (optional — only commit if using offline mode)
.sqlx/

# Python virtual environments
.venv/
venv/
env/
.env/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo


/.claude