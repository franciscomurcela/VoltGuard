# Rust build artifacts (multi-service monorepo)
**/target/

# Cargo.lock is kept for applications (binary crates)
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# Environment files (contain secrets — never commit)
.env
.env.local
.env.*.local

# Kubernetes secrets (real values — copy from k8s/secrets.yaml.example)
k8s/secrets.yaml

# Local Kubernetes backups (may contain secrets)
backup-*.yaml

# Local docker-compose override (dev-only host port exposures)
docker-compose.override.yaml
docker-compose.override.yml

# Firmware binary storage (large binary files)
**/firmware_storage/

# Binary files
*.bin

# SQLx offline query cache (optional — only commit if using offline mode)
.sqlx/

# Python virtual environments
.venv/
venv/
env/
.env/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo


/.claude

# Local test CSVs
composer-service/sensors_import_clean.csv
composer-service/sensors_import*.csv

