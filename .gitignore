# Rust build artifacts (multi-service monorepo)
**/target/

# Cargo.lock is kept for applications (binary crates)
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# Environment files (contain secrets — never commit)
.env
.env.local
.env.*.local

# Firmware binary storage (large binary files)
**/firmware_storage/

# Binary files
*.bin

# SQLx offline query cache (optional — only commit if using offline mode)
.sqlx/

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
