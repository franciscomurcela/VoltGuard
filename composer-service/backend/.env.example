# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=iot-compositor
KEYCLOAK_CLIENT_ID=compositor-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ─── Peer Services (K8s internal DNS or localhost for dev) ───────────────────
OAM_SERVICE_URL=http://oam-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
ANOMALY_SERVICE_URL=http://anomaly-service:8080

# ─── Proxy Settings ─────────────────────────────────────────────────────────
PROXY_TIMEOUT_MS=5000
PROXY_RETRY_COUNT=2
PROXY_RETRY_DELAY_MS=500

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Anomaly → Notification Pipeline ────────────────────────────────────────
# URL the anomaly service will POST webhooks to (must be reachable from the anomaly container)
COMPOSER_BASE_URL=http://compositor-backend:8080
# Comma-separated Keycloak user IDs to notify when an anomaly is detected
ANOMALY_NOTIFY_USER_IDS=user-id-1,user-id-2

# ─── Digest Scheduler ────────────────────────────────────────────────────────
# How often the compositor flushes the notifications digest queue (ms). Default: 1 hour.
DIGEST_INTERVAL_MS=3600000
