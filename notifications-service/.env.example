MONGODB_URL=mongodb://admin:notifications_password@localhost:27017
MONGODB_DATABASE=notifications_db
SERVER_HOST=0.0.0.0
SERVER_PORT=8083
AUTH_TOKEN=your_secure_auth_token

# Twilio Configuration (handles SMS, WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890
TWILIO_FROM_WHATSAPP=whatsapp:+1234567890
TWILIO_FROM_EMAIL=alertasvoltguard@gmail.com

# SMTP (Email via Gmail + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=alertasvoltguard@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=alertasvoltguard@gmail.com

# Seed defaults on startup
SEED_DEFAULT_PREFERENCES=true

LOG_LEVEL=INFO
