MONGODB_URL=mongodb://admin:notifications_password@localhost:27017
MONGODB_DATABASE=notifications_db
SERVER_HOST=0.0.0.0
SERVER_PORT=8083
AUTH_TOKEN=your_secure_auth_token

# Twilio Configuration (handles SMS, WhatsApp, Email)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890
TWILIO_FROM_WHATSAPP=whatsapp:+1234567890
TWILIO_FROM_EMAIL=noreply@voltguard.com

# SendGrid (for email via Twilio)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LOG_LEVEL=INFO
